<div class="admin-verify-wrapper">
    <div class="verify-container">
        <h2 class="mb-4 text-center fw-bold">Security Check</h2>
        <p class="text-center text-muted mb-4">Please enter your password to confirm this action.</p>

        <form method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-group-large">
                <label class="form-label">Admin Password</label>
                <input type="password" name="password" class="form-control form-control-lg" placeholder="••••••••" required autofocus />
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-danger btn-lg-custom">Continue</button>
            </div>

            <div class="text-center mt-3">
                <a href="javascript:history.back()" class="text-secondary text-decoration-none">Go Back</a>
            </div>
        </form>
    </div>
</div>

<style>
    /* Center the box on the page */
    .admin-verify-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        padding: 20px;
    }

    /* The styled card box */
    .verify-container {
        background: #ffffff;
        padding: 50px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 500px; /* Big but contained */
        border-top: 6px solid #dc3545; /* Red accent at the top */
    }

    /* Label styling */
    .form-group-large label {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 12px;
        display: block;
        color: #495057;
    }

    /* Big Password Input */
    .form-group-large .form-control {
        height: auto;
        padding: 18px;
        font-size: 1.4rem; /* Big dots */
        border-radius: 10px;
        border: 2px solid #dee2e6;
        letter-spacing: 2px; /* Spaces out password dots */
    }

        .form-group-large .form-control:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.15);
        }

    /* The Big Continue Button */
    .btn-lg-custom {
        padding: 16px;
        font-size: 1.3rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-lg-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        }
</style>