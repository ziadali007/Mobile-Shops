
@{
    ViewData["Title"] = "Admin Verification";
}
<link rel="stylesheet" href="~/css/AdminPassword.css" asp-append-version="true" />

<div class="admin-page-wrapper">
    <div class="admin-lock-box">
        <div class="lock-icon">🔒</div>
        <h2>Admin Verification</h2>
        <p class="text-muted">Please enter the administrator password to continue.</p>

        <form asp-action="VerifyAdmin" method="post">
            <input type="hidden" name="returnAction" value="@ViewBag.ReturnAction" />
            <input type="hidden" name="returnController" value="@ViewBag.ReturnController" />
            <input type="hidden" name="routeValue" value="@ViewBag.RouteValue" />

            <div class="form-group-custom">
                <label>Admin Password</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required autofocus />
            </div>

            <button type="submit" class="btn btn-danger btn-verify">Verify Identity</button>

            @if (ViewBag.Error != null)
            {
                <div class="error-message">
                    <strong>Error:</strong> @ViewBag.Error
                </div>
            }
        </form>

        <div class="mt-3">
            <a asp-action="Index" class="text-decoration-none">← Cancel and Go Back</a>
        </div>
    </div>
</div>

