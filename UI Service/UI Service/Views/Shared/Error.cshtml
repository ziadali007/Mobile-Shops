@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<link rel="stylesheet" href="~/css/Error.css" />

<div class="error-wrapper">
    <div class="error-container">
        <h1 class="text-danger fw-bold">Error.</h1>
        <h2 class="text-white-50">An error occurred while processing your request.</h2>

        <hr class="border-light opacity-25" />

        @if (Model.ShowRequestId)
        {
            <p class="request-id-box">
                <strong class="text-white">Request ID:</strong>
                <code class="text-warning">@Model.RequestId</code>
            </p>
        }

        <div class="dev-mode-notice">
            <h3 class="text-white">Development Mode</h3>
            <p>
                Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
            </p>
            <p class="alert alert-warning bg-transparent text-warning border-warning">
                <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
                It can result in displaying sensitive information from exceptions to end users.
            </p>
        </div>

        <div class="mt-4">
            <a href="javascript:history.back()" class="btn btn-outline-light">Go Back</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Home</a>
        </div>
    </div>
</div>