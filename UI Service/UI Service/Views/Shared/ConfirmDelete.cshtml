<div class="delete-page-wrapper">
    <div class="delete-confirm-box">
        <div class="warning-icon">⚠️</div>
        <h2>Are you absolutely sure?</h2>
        <p class="text-muted mb-4">
            This action cannot be undone. This will permanently delete the selected item.
        </p>

        <form asp-action="DeleteConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model" />

            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-danger btn-confirm-lg">
                    Yes, Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary btn-cancel-lg">
                    No, Keep it
                </a>
            </div>
        </form>
    </div>
</div>


<style>
    /* Center the delete box perfectly on the screen */
    .delete-page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh; /* Takes up most of the screen height */
        padding: 20px;
    }

    /* The Warning Card */
    .delete-confirm-box {
        background: white;
        padding: 60px; /* Extra padding for a "big" feel */
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        width: 100%;
        max-width: 600px;
        text-align: center;
        border-bottom: 8px solid #dc3545; /* Red accent at the bottom */
    }

    .warning-icon {
        font-size: 5rem;
        margin-bottom: 20px;
    }

    .delete-confirm-box h2 {
        font-size: 2.5rem;
        font-weight: 800;
        color: #212529;
        margin-bottom: 15px;
    }

    .delete-confirm-box p {
        font-size: 1.25rem;
        line-height: 1.6;
    }

    /* Big Buttons */
    .btn-confirm-lg {
        padding: 18px;
        font-size: 1.4rem;
        font-weight: 700;
        border-radius: 12px;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

        .btn-confirm-lg:hover {
            background-color: #bb2d3b;
            transform: scale(1.02); /* Slight pop out effect on hover */
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4);
        }

    .btn-cancel-lg {
        padding: 15px;
        font-size: 1.2rem;
        border-radius: 12px;
        border-width: 2px;
    }
</style>