@using Shared.UI
@model IEnumerable<SaleProductDto>
<link rel="stylesheet" href="~/css/Sale.css" />

<div class="container-fluid">
    

    @if (!Model.Any())
    {
        <div class="alert alert-info p-5 fs-3 text-center">
            No Sales available.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-bordered table-striped table-hover big-sales-table">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                        <th style="min-width: 200px;">Notes</th>
                        <th>Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.ProductName</td>
                            <td><span class="badge bg-light text-dark fs-6 border">@item.Type</span></td>
                            <td class="fw-bold">@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td class="text-success fw-bold">@item.Total.ToString("C")</td>
                            <td class="text-start small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                            <td>@item.Time.ToString("HH:mm:ss")</td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-action"
                                            onclick="return confirm('Are you sure you want to delete this item?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>