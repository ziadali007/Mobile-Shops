@using Shared.UI
@model List<ProductDto>

<link rel="stylesheet" href="~/css/index.css" />

<div class="page-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-6 fw-bold m-0">Products</h2>
        <a class="btn btn-primary btn-lg" asp-action="Create">Create New Product</a>
    </div>

    <form method="get" class="search-form">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search by name or type..." />

        <button class="btn btn-outline-primary px-5" type="submit">
            Search
        </button>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info p-4 fs-5">
            No products available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover table-lg-custom">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th style="min-width: 180px;">Actions</th>
                        <th>Sale</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.Type</td>
                            <td>@item.Price</td>
                            <td>@item.Quantity</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                                <a asp-action="ConfirmDelete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger">
                                    Delete
                                </a>
                            </td>
                            <td>
                                <button class="btn btn-success"
                                        onclick="openSaleModal('@item.Id', '@item.Type')">
                                    Add to Sale
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="saleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-4">Add to Sale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post"
                  asp-controller="@ViewBag.SaleController"
                  asp-action="Add">

                <div class="modal-body p-4">
                    <input type="hidden" id="ProductId" name="Id" />
                    <input type="hidden" id="ProductType" name="Type" />

                    <div class="mb-4">
                        <label class="form-label fs-5">Quantity</label>
                        <input type="number"
                               name="Quantity"
                               class="form-control form-control-lg"
                               min="1"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fs-5">Notes</label>
                        <textarea name="notes"
                                  id="ProductNotes"
                                  class="form-control form-control-lg"
                                  rows="3"
                                  placeholder="Enter notes..."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-lg" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-lg">Add to Sale</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openSaleModal(id, type) {
        document.getElementById("ProductId").value = id;
        document.getElementById("ProductType").value = type;
        var modal = new bootstrap.Modal(document.getElementById('saleModal'));
        modal.show();
    }
</script>

<style>
    /* 1. Reduce container width and make background transparent */
    .page-container {
        max-width: 80%; /* Reduced from 90% to make it smaller */
        margin: 40px auto;
        padding: 30px;
        /* Semi-transparent white (Glass effect) */
        background-color: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px); /* Blurs the background image slightly */
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        color: white; /* Makes text readable on dark backgrounds */
    }

    /* 2. Make Table Transparent */
    .table-lg-custom {
        width: 100%;
        background-color: transparent !important;
        color: white !important;
    }

        /* 3. Header Styling */
        .table-lg-custom th {
            background-color: rgba(0, 0, 0, 0.3) !important; /* Darker transparent header */
            color: #fff !important;
            font-size: 1.1rem;
            border-color: rgba(255, 255, 255, 0.1) !important;
        }

        /* 4. Row Styling */
        .table-lg-custom td {
            background-color: transparent !important;
            color: white !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
            vertical-align: middle;
        }

    /* 5. Search Bar Transparency */
    .search-form {
        display: flex;
        gap: 10px;
        margin-bottom: 25px;
    }

        .search-form .form-control {
            background-color: rgba(255, 255, 255, 0.9); /* Keep input bright for typing */
            border: none;
        }

    /* Makes Title visible on dark background */
    h2.display-6 {
        color: white;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
</style>