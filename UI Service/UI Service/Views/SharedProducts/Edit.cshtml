@using Shared.UI
@model UpdateProductDto
<link rel="stylesheet" href="~/css/Edit.css" />

<div class="edit-page-wrapper">
    <div class="form-container">
        <h2>Edit Product</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group-custom">
                <label>Product Name</label>
                <input class="form-control" name="Name" value="@Model.Name" required />
            </div>

            <div class="form-group-custom">
                <label>Quantity</label>
                <input class="form-control" name="Quantity" type="number"
                       value="@Model.Quantity" required />
            </div>

            <div class="form-group-custom">
                <label>Price ($)</label>
                <input class="form-control" name="Price" type="number" step="0.01"
                       value="@Model.Price" required />
            </div>

            <div class="button-group">
                <button class="btn btn-warning btn-lg-custom">Update Product</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg-custom">Back to List</a>
            </div>
        </form>
    </div>
</div>